APP_NAME=EcomClaude
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://ecomclaude.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# When set, the Filament admin panel binds to this hostname instead of the
# "/admin" path prefix — see AdminPanelProvider.php and config/app.php.
# Matches the convention gasflow (gas-distribution) uses for its own
# admin subdomain.
ADMIN_DOMAIN=admin.ecomclaude.local

# Direct-port fallback for nginx, independent of Traefik — see the
# "nginx" service comment in docker-compose.yml.
APP_PORT=8897

# Which GHCR image tag docker-compose.yml's "app"/"queue"/"nginx" services
# pull. .github/workflows/deploy.yml pushes both "latest" and the commit SHA
# on every push to main — leave this as "latest" for normal deploys, or pin
# it to a specific SHA on the VPS to roll back without a git revert.
IMAGE_TAG=latest

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Deliberately a separate schema from the WSL dev database ("claude_ecom")
# so the Docker stack never touches live dev data. Create it once:
#   CREATE DATABASE `claude_ecom_docker` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
# docker-compose.yml overrides this to host.docker.internal for every
# service regardless of what's set here — left as 127.0.0.1 just so this
# file is also usable directly with `php artisan` outside a container.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claude_ecom_docker
DB_USERNAME=jubaer
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=collection

VITE_APP_NAME="${APP_NAME}"
